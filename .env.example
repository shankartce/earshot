# Optional: turn on the room AI DJ and mood playlists. Copy to .env and pick ONE block.
# The key stays on the server; browsers never see it. With no AI_MODEL, AI stays off.
# The AI sees song titles/artists/lengths, display names and recent chat. Never audio.

# OpenAI
# AI_MODEL=gpt-4o-mini
# AI_API_KEY=sk-...

# Anthropic (native API)
# AI_PROVIDER=anthropic
# AI_MODEL=claude-sonnet-5-5
# AI_API_KEY=sk-ant-...

# OpenRouter (hundreds of models, open source included)
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_MODEL=meta-llama/llama-3.3-70b-instruct
# AI_API_KEY=sk-or-...

# Groq
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL=llama-3.3-70b-versatile
# AI_API_KEY=gsk_...

# Local, free and private: Ollama (`ollama pull llama3.1`), LM Studio, vLLM or llama.cpp
# AI_BASE_URL=http://localhost:11434/v1
# AI_MODEL=llama3.1

# Local models can be slow; raise this if answers time out (milliseconds).
# AI_TIMEOUT_MS=30000
